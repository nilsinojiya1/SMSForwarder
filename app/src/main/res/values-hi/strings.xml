    <!-- Prominent Disclosure & Ethical Consent Dialog -->
    <string name="consent_dialog_title">प्रमुख प्रकटीकरण और सुरक्षा समझौता</string>
    <string name="consent_dialog_subtitle">कृपया डेटा एक्सेस और नैतिक उपयोग की शर्तों की समीक्षा करें</string>
    <string name="consent_sec1_title">1. एसएमएस और टेलीफोनी डेटा एक्सेस</string>
    <string name="consent_sec1_body">SMS Forwarder को अपने मुख्य कार्य को करने के लिए अनुमतियों (RECEIVE_SMS, READ_SMS, READ_PHONE_STATE) की आवश्यकता होती है: आपके आने वाले एसएमएस को आपके निर्दिष्ट टेलीग्राम बॉट या चैट पर स्वचालित रूप से फॉरवर्ड करना।</string>
    <string name="consent_sec1_bullet1">एक्सेस किया गया डेटा: प्रेषक का फोन नंबर, संदेश का टेक्स्ट और टाइमस्टैम्प।</string>
    <string name="consent_sec1_bullet2">उद्देश्य: आपके निजी टेलीग्राम एंडपॉइंट पर त्वरित स्वचालित फॉरवर्डिंग।</string>
    <string name="consent_sec2_title">2. डेटा गोपनीयता और शून्य तृतीय-पक्ष साझाकरण</string>
    <string name="consent_sec2_body">आपकी गोपनीयता और संचार सुरक्षा हमारी सर्वोच्च प्राथमिकता है:</string>
    <string name="consent_sec2_bullet1">सीधा प्रसारण: संदेश आपके कॉन्फ़िगर किए गए बॉट टोकन का उपयोग करके सीधे HTTPS के माध्यम से आधिकारिक टेलीग्राम बॉट एपीआई पर प्रसारित होते हैं।</string>
    <string name="consent_sec2_bullet2">कोई एनालिटिक्स या विज्ञापन ट्रैकर नहीं: हम आपका एसएमएस डेटा कभी भी तीसरे पक्ष के विज्ञापन नेटवर्क, टेलीमेट्री प्रदाताओं या सर्वरों को नहीं बेचते या साझा करते हैं।</string>
    <string name="consent_sec2_bullet3">स्थानीय भंडारण: संग्रहीत संदेश पूरी तरह से आपके स्थानीय डिवाइस डेटाबेस पर और आपके 4-अंकीय पिन द्वारा सुरक्षित रहते हैं।</string>
    <string name="consent_sec3_title">3. नैतिक और वैध उपयोग नीति</string>
    <string name="consent_sec3_body">इस एप्लिकेशन का उपयोग करके, आप स्पष्ट रूप से सहमत होते हैं कि:</string>
    <string name="consent_sec3_bullet1">केवल अधिकृत डिवाइस: आप इस एप्लिकेशन को केवल उन्हीं डिवाइसों पर इंस्टॉल और संचालित करेंगे जो आपके कानूनी स्वामित्व में हैं या जिनके मालिक से आपने स्पष्ट सहमति प्राप्त की है।</string>
    <string name="consent_sec3_bullet2">कोई गुप्त जासूसी / स्टॉकिंग नहीं: उपयोगकर्ता की जानकारी के बिना गुप्त निगरानी, जासूसी या निजी संचार को इंटरसेप्ट करने के लिए इस ऐप का उपयोग सख्त वर्जित और गैरकानूनी है।</string>
    <string name="consent_sec3_bullet3">फ़ोरग्राउंड सूचना: सक्रिय होने पर, पूर्ण पारदर्शिता सुनिश्चित करने के लिए स्टेटस बार में हमेशा एक सतत सूचना प्रदर्शित होती है।</string>
    <string name="consent_affirmation">स्वीकृति दर्शाती है कि आपने इन नैतिक उपयोग शर्तों और गोपनीयता प्रकटीकरण को पढ़, समझ और स्वीकार कर लिया है।</string>
    <string name="consent_action_close">समीक्षा बंद करें</string>
    <string name="consent_action_agree">सहमत हों और जारी रखें</string>
    <string name="consent_action_decline">अस्वीकार करें और बाहर निकलें</string>

