    <!-- Prominent Disclosure & Ethical Consent Dialog -->
    <string name="consent_dialog_title">重要声明与安全协议</string>
    <string name="consent_dialog_subtitle">请仔细阅读数据访问及合规使用条款</string>
    <string name="consent_sec1_title">1. 短信与电话数据访问</string>
    <string name="consent_sec1_body">SMS Forwarder 需要运行时权限 (RECEIVE_SMS, READ_SMS, READ_PHONE_STATE) 以执行其核心功能：自动将接收到的短信通知转发到您指定的 Telegram 机器人或聊天中。</string>
    <string name="consent_sec1_bullet1">访问的数据：发件人电话号码、短信文本内容以及时间戳。</string>
    <string name="consent_sec1_bullet2">使用目的：即时自动化转发至您的私人 Telegram 终端。</string>
    <string name="consent_sec2_title">2. 数据隐私与零第三方共享</string>
    <string name="consent_sec2_body">您的隐私和通信安全是我们的最高准则：</string>
    <string name="consent_sec2_bullet1">直接传输：消息使用您自行配置的 Bot Token，直接通过 HTTPS 加密传输至 Telegram 官方 API。</string>
    <string name="consent_sec2_bullet2">无分析与广告追踪：我们绝不会向第三方广告网络、遥测服务商或远程服务器出售、变现或传输您的短信数据。</string>
    <string name="consent_sec2_bullet3">本地存储：存储的消息严格保存在您设备的本地数据库中，并受到 4 位 PIN 码的保护。</string>
    <string name="consent_sec3_title">3. 合规与合法使用准则</string>
    <string name="consent_sec3_body">使用本应用即表示您明确同意并保证：</string>
    <string name="consent_sec3_bullet1">仅限授权设备：您仅在您合法拥有的设备上安装并运行本应用，或者您已获得设备所有者的明确知情同意。</string>
    <string name="consent_sec3_bullet2">禁止秘密监视/跟踪：严禁将本应用用于未经授权的秘密监视、间谍活动、跟踪或在用户不知情的情况下秘密截获私人通信。</string>
    <string name="consent_sec3_bullet3">前台常驻通知：在激活状态下，Android 状态栏始终会显示常驻前台通知，以确保操作的完全透明。</string>
    <string name="consent_affirmation">接受即表示您已阅读、理解并同意遵守这些合规使用条款和隐私声明。</string>
    <string name="consent_action_close">关闭政策查看</string>
    <string name="consent_action_agree">同意并继续</string>
    <string name="consent_action_decline">拒绝并退出</string>

