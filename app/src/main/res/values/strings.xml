    <!-- Prominent Disclosure & Ethical Consent Dialog -->
    <string name="consent_dialog_title">Prominent Disclosure &amp; Security Agreement</string>
    <string name="consent_dialog_subtitle">Please review data access &amp; ethical use terms</string>
    <string name="consent_sec1_title">1. SMS &amp; Telephony Data Access</string>
    <string name="consent_sec1_body">SMS Forwarder requires runtime permissions (RECEIVE_SMS, READ_SMS, READ_PHONE_STATE) to perform its core function: automatically forwarding your incoming SMS notifications to your designated Telegram Bot or Chat.</string>
    <string name="consent_sec1_bullet1">Accessed Data: Sender telephone number, message text content, and timestamp.</string>
    <string name="consent_sec1_bullet2">Purpose: Instant automated forwarding to your private Telegram endpoint.</string>
    <string name="consent_sec2_title">2. Data Privacy &amp; Zero Third-Party Sharing</string>
    <string name="consent_sec2_body">Your privacy and communication security are our top priorities:</string>
    <string name="consent_sec2_bullet1">Direct Transmission: Messages are transmitted directly via HTTPS to the official Telegram Bot API using your self-configured Bot Token.</string>
    <string name="consent_sec2_bullet2">No Analytics or Ad Trackers: We never sell, monetize, or transmit your SMS data to third-party ad networks, telemetry providers, or remote servers.</string>
    <string name="consent_sec2_bullet3">Local Storage: Stored messages are kept strictly on your local device database and protected by your 4-digit PIN.</string>
    <string name="consent_sec3_title">3. Ethical &amp; Lawful Use Policy</string>
    <string name="consent_sec3_body">By using this application, you explicitly agree and certify that:</string>
    <string name="consent_sec3_bullet1">Authorized Devices Only: You will only install and operate this application on devices that you legally own or for which you have received express, informed consent from the device owner.</string>
    <string name="consent_sec3_bullet2">No Covert Spying / Stalking: Using this application for unauthorized surveillance, clandestine tracking, spying, stalking, or secretly intercepting private communications without the explicit knowledge of the user is strictly prohibited and unlawful.</string>
    <string name="consent_sec3_bullet3">Foreground Notification: When active, a persistent Android foreground notification is always displayed on the device status bar to ensure full operational transparency.</string>
    <string name="consent_affirmation">Acceptance indicates you have read, understood, and agree to abide by these ethical use terms and privacy disclosure.</string>
    <string name="consent_action_close">Close Policy Review</string>
    <string name="consent_action_agree">Agree &amp; Continue</string>
    <string name="consent_action_decline">Decline &amp; Exit</string>

